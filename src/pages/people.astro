---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { people } from '../data/people';
import { images } from '../data/images';
import { stationById } from '../data/stations';
import { stationUrl } from '../lib/paths';
---

<Base title="الأعلام" description="ستة أعلام مصوَّرين في تاريخ دراسة اللغة، وصلة كل منهم بمحطته." current="people/">
  <header class="wrap p-intro">
    <p class="eyebrow">الأعلام</p>
    <h1>ستة وجوه، ست محطات</h1>
    <p class="lede measure">
      يربط هذا القسم كل علم بمحطته وإسهامه كما يرد في المادة المرجعية، دون سيرة شخصية إضافية. الصور كلها أعمال فنية: التصورات التخيّلية لا تدّعي معرفة ملامح أصحابها، والبورتريهات المولّدة ليست صوراً أرشيفية.
    </p>
  </header>

  <ol class="plist wrap">
    {
      people.map((p, i) => {
        const st = stationById.get(p.station)!;
        const img = images[p.portrait];
        return (
          <li class:list={['person', { flip: i % 2 === 1 }]} id={p.id}>
            <figure class="person-fig">
              <div class="frame">
                <Pic id={p.portrait} sizes="(min-width: 52rem) 26rem, 90vw" />
              </div>
              <figcaption>{img.caption}</figcaption>
            </figure>
            <div class="person-text">
              <p class="person-st">
                <a href={stationUrl(st)}>المحطة {st.id} · {st.short}</a>
              </p>
              <h2>
                {p.name}
                {p.latin && <span class="latin" dir="ltr" lang="en">{p.latin}</span>}
              </h2>
              <p class="person-era">{p.era}</p>
              <p class="person-contrib">{p.contribution}</p>
              {p.works.length > 0 && (
                <p class="person-works">
                  <strong>أعمال مرتبطة:</strong> {p.works.map((w) => `«${w}»`).join('، ')}
                </p>
              )}
              <p class="person-q">
                <span>سؤال المحطة:</span> {st.question}
              </p>
              <a class="more" href={stationUrl(st)}>اكتشف المحطة</a>
            </div>
          </li>
        );
      })
    }
  </ol>
</Base>

<style>
  .p-intro {
    padding-block: clamp(2rem, 5vw, 4rem) 1rem;
  }
  .plist {
    list-style: none;
    padding: 0;
    margin-block: 1rem 4rem;
  }
  .person {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 52rem) {
    .person {
      grid-template-columns: minmax(0, 26rem) 1fr;
      align-items: center;
    }
    .person.flip .person-fig {
      order: 2;
    }
  }
  .person-fig {
    max-width: 26rem;
  }
  .person-st {
    font-family: var(--font-display);
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
  }
  .person h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    margin-bottom: 0.2rem;
  }
  .person h2 .latin {
    font-size: 1rem;
    color: var(--ink-soft);
    font-weight: 400;
  }
  .person-era {
    font-family: var(--font-display);
    color: var(--copper);
    font-size: 0.95rem;
  }
  .person-contrib {
    font-size: var(--step-1);
    line-height: 1.85;
    max-width: 36rem;
  }
  .person-works {
    color: var(--ink-soft);
  }
  .person-works strong,
  .person-q span {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
  }
  .person-q {
    padding: 0.6rem 0.9rem;
    background: var(--paper);
    border-inline-start: 3px solid var(--prussian);
    max-width: 36rem;
  }
</style>
