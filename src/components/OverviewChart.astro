---
/**
 * رسم عام لتزامن الاتجاهات: لكل محطة شريط يمثل فترتها التقريبية.
 * المحور مقسوم إلى حقب متساوية العرض، فالمسافات غير متناسبة مع الزمن.
 * يبدأ الزمن من اليمين (الأقدم) إلى اليسار (الأحدث) وفق اتجاه القراءة العربية.
 */
import { stations } from '../data/stations';
import { dateKinds } from '../data/taxonomy';
import { stationUrl } from '../lib/paths';

interface Props {
  id?: string;
  caption?: boolean;
}
const { id = 'overview', caption = true } = Astro.props;

const segs = [
  { label: 'العصور القديمة', from: -3200, to: 500 },
  { label: 'من القرن 6 إلى 17', from: 500, to: 1700 },
  { label: 'القرنان 18 و19', from: 1700, to: 1900 },
  { label: '1900–1950', from: 1900, to: 1950 },
  { label: '1950–1980', from: 1950, to: 1980 },
  { label: '1980 حتى اليوم', from: 1980, to: 2026 },
];
const N = segs.length;
function pos(year: number): number {
  const i = Math.max(
    0,
    segs.findIndex((s) => year >= s.from && year <= s.to),
  );
  const s = segs[i];
  return ((i + (year - s.from) / (s.to - s.from)) / N) * 100;
}
const rows = stations.map((s) => {
  const a = pos(s.chart.from);
  let b = pos(s.chart.to);
  if (b - a < 1.4) b = a + 1.4;
  return {
    s,
    start: a,
    width: b - a,
    end: b,
    marks: (s.chart.marks ?? []).map((m) => ({ ...m, at: pos(m.year) })),
  };
});
const f = (n: number) => n.toFixed(2) + '%';
---

<figure class="overview" id={id} aria-labelledby={`${id}-title`}>
  <div class="ov-head">
    <h3 id={`${id}-title`} class="ov-title">تزامن المحطات وتفرعها</h3>
    <p class="ov-note">
      كل حقبة تأخذ عرضاً متساوياً، <strong>فالمسافات غير متناسبة مع الزمن</strong>. الزمن يبدأ من اليمين. الحواف الباهتة تعني فترة تقريبية، والخط المتقطع يعني أن الاتجاه استمر ولم يُلغَ.
    </p>
  </div>
  <div class="ov-chart">
    <div class="ov-axis" aria-hidden="true">
      <span class="ov-axis-spacer"></span>
      <div class="ov-axis-segs">
        {segs.map((sg) => <span>{sg.label}</span>)}
      </div>
    </div>
    <ol class="ov-rows">
    {
      rows.map((r) => (
        <li><a
          class="ov-row"
          data-id={r.s.id}
          href={stationUrl(r.s)}
          aria-label={`المحطة ${r.s.id}: ${r.s.short} — ${r.s.period}`}
        >
          <span class="ov-label">
            <span class="ov-num">{r.s.id}</span>
            <span class="ov-name">{r.s.short}</span>
          </span>
          <span class="ov-track" aria-hidden="true">
            {r.s.chart.ongoing && (
              <span class="ov-tail" style={`inset-inline-start:${f(r.end)};width:calc(${f(100 - r.end)} - 4px)`} />
            )}
            <span
              class:list={['ov-bar', { fuzzy: r.s.chart.fuzzy }]}
              style={`inset-inline-start:${f(r.start)};width:${f(r.width)}`}
            />
            {r.marks.map((m) => (
              <span class={`ov-mark mk-${m.kind}`} style={`inset-inline-start:${f(m.at)}`} title={`${m.label} · ${dateKinds[m.kind].name}`} />
            ))}
          </span>
        </a></li>
      ))
    }
    </ol>
  </div>
  {
    caption && (
      <figcaption class="ov-legend">
        <span><i class="lg lg-bar" />فترة نشاط</span>
        <span><i class="lg lg-fuzzy" />فترة تقريبية</span>
        <span><i class="lg lg-tail" />استمرار الاتجاه</span>
        <span><i class="lg mk-publication" />نشر عمل</span>
        <span><i class="lg mk-tool" />أداة أو مورد</span>
        <span><i class="lg mk-event" />واقعة مؤسسية</span>
      </figcaption>
    )
  }
</figure>

<style>
  .overview {
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: clamp(1rem, 3vw, 2rem);
    box-shadow: 0 18px 40px -32px rgba(30, 37, 51, 0.5);
  }
  .ov-title {
    font-size: var(--step-1);
    margin-bottom: 0.3rem;
  }
  .ov-note {
    font-size: var(--step--1);
    color: var(--ink-soft);
    max-width: 46rem;
    margin-bottom: 1.2rem;
  }
  .ov-note strong {
    color: var(--copper);
    font-weight: 600;
  }
  .ov-chart {
    --label: 11.5rem;
    display: grid;
    gap: 1px;
  }
  .ov-axis,
  .ov-row {
    display: grid;
    grid-template-columns: var(--label) 1fr;
    align-items: center;
  }
  .ov-axis {
    position: sticky;
    top: 4rem;
    z-index: 2;
    background: var(--paper);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .ov-axis-segs {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    font-family: var(--font-display);
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--ink-soft);
  }
  .ov-axis-segs span {
    padding-inline: 0.3rem;
    border-inline-start: 1px solid var(--rule-strong);
  }
  .ov-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .ov-row {
    min-height: 1.55rem;
    text-decoration: none;
    color: var(--ink);
    border-radius: 2px;
    transition: opacity 0.25s ease, background-color 0.2s ease;
  }
  .ov-row:hover,
  .ov-row:focus-visible {
    background: var(--prussian-tint);
  }
  .ov-row:hover .ov-bar,
  .ov-row:focus-visible .ov-bar {
    background: var(--copper);
  }
  .ov-row.is-dim {
    opacity: 0.22;
  }
  .ov-row.is-current {
    background: #f3e3c8;
  }
  .ov-label {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
    font-size: 0.82rem;
    line-height: 1.3;
    padding-inline-end: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .ov-num {
    font-family: var(--font-display);
    color: var(--copper);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ov-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ov-track {
    position: relative;
    height: 1.55rem;
    background-image: linear-gradient(to left, var(--rule) 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
  }
  .ov-bar {
    position: absolute;
    top: 0.5rem;
    height: 0.55rem;
    border-radius: 99px;
    background: var(--prussian);
  }
  .ov-bar.fuzzy {
    background: linear-gradient(
      to left,
      color-mix(in srgb, var(--prussian) 10%, transparent),
      var(--prussian) 28%,
      var(--prussian) 72%,
      color-mix(in srgb, var(--prussian) 10%, transparent)
    );
  }
  .ov-tail {
    position: absolute;
    top: calc(0.5rem + 0.24rem);
    height: 0;
    border-top: 1.5px dashed color-mix(in srgb, var(--prussian) 55%, transparent);
  }
  .ov-mark {
    position: absolute;
    top: 0.36rem;
    width: 0.8rem;
    height: 0.8rem;
    margin-inline-start: -0.4rem;
    background: var(--copper);
    border: 1.5px solid var(--paper);
  }
  .mk-publication {
    border-radius: 1px;
  }
  .mk-tool {
    transform: rotate(45deg) scale(0.85);
  }
  .mk-event {
    border-radius: 50%;
  }
  .ov-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 1rem;
    border: 0;
    padding: 0;
  }
  .ov-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .lg {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--copper);
  }
  .lg-bar,
  .lg-fuzzy {
    width: 1.8rem;
    height: 0.5rem;
    border-radius: 99px;
    background: var(--prussian);
  }
  .lg-fuzzy {
    background: linear-gradient(to left, transparent, var(--prussian) 35%, var(--prussian) 65%, transparent);
  }
  .lg-tail {
    width: 1.8rem;
    height: 0;
    background: none;
    border-top: 1.5px dashed var(--prussian);
  }
  @media (max-width: 40rem) {
    .ov-chart {
      --label: 2.4rem;
    }
    .ov-name {
      display: none;
    }
    .ov-axis-segs {
      font-size: 0.6rem;
    }
    .ov-axis-segs span {
      padding-inline: 0.15rem;
    }
    .ov-axis {
      top: 4rem;
    }
  }
</style>
